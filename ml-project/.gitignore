.venv/
__pycache__/
.ipynb_checkpoints/

# Data: downloaded and generated by the pipeline. Only the folder structure is versioned.
data/**/*
!data/**/
!data/**/.gitkeep

# Trained models
models/**/*
!models/.gitkeep

# Heavy parts of the state of the runs. Tables, figures, folds, judge answers and
# cost records stay versioned.
results/runs/*/interim/
results/runs/*/cache/
results/runs/*/cost/traces/
# Weights and checkpoints of the transformer during training (the chosen model goes to models/).
results/runs/*/transformer/**/model/
results/runs/*/transformer/**/checkpoint-*/
